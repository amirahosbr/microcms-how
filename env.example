# microCMS HOW TO?
# Copy this file to .env and fill in your real values.
# Get these from microCMS: サービス設定 → API設定 (or APIキー in the dashboard).

# ── Required ──────────────────────────────────────────────────────────────
# Your microCMS service domain, e.g. "your-service" for https://your-service.microcms.io
MICROCMS_SERVICE_DOMAIN=your-service-domain

# microCMS API key (read access is enough for the public site)
MICROCMS_API_KEY=your-api-key

# Content API endpoint for the news list, e.g. "news"
# Used by scripts/build-cache-data.mjs
MICROCMS_NEWS_ENDPOINT=news

# ── Optional ──────────────────────────────────────────────────────────────
# Webhook secret. Set the SAME value in microCMS:
# API設定 → Webhook → カスタム通知 → セキュリティ保護.
# Without it, POST /api/webhook has no signature to verify.
MICROCMS_WEBHOOK_SECRET=your-webhook-secret
